<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_customer_outstanding_own" model="ir.rule">
        <field name="name">Customer outstanding balances: own rows</field>
        <field name="model_id" ref="model_d05_customer_outstanding"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('D05_custom.group_customer_outstanding'))]"/>
    </record>
    <record id="rule_customer_outstanding_wizard_own" model="ir.rule">
        <field name="name">Customer outstanding wizard: own rows</field>
        <field name="model_id" ref="model_d05_customer_outstanding_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('D05_custom.group_customer_outstanding'))]"/>
    </record>
</odoo>
