<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_minimum_price" model="ir.ui.view">
        <field name="name">product.template.form.minimum.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='pricing']" position="after">
                <label for="minimum_price"/>
                <div name="minimum_pricing" class="o_row">
                    <field name="minimum_price" class="oe_inline" widget="monetary"
                           options="{'currency_field': 'currency_id', 'field_digits': True}"
                           groups="account.group_account_manager,base.group_system"/>
                    <field name="minimum_price" class="oe_inline" widget="monetary" readonly="1"
                           options="{'currency_field': 'currency_id', 'field_digits': True}"
                           groups="!account.group_account_manager,!base.group_system"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_minimum_price" model="ir.ui.view">
        <field name="name">product.template.tree.minimum.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="after">
                <field name="minimum_price" optional="show" readonly="1" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
            </field>
        </field>
    </record>

    <record id="product_variant_form_minimum_price" model="ir.ui.view">
        <field name="name">product.product.form.minimum.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- The variant sales price writes the template sales price. Same editors as the template form. -->
            <field name="lst_price" position="attributes">
                <attribute name="groups">D05_custom.group_sales_order_price_manager,D05_custom.group_price_manager,account.group_account_manager,base.group_system</attribute>
            </field>
            <field name="lst_price" position="after">
                <field name="lst_price" readonly="1" widget="monetary"
                       options="{'currency_field': 'currency_id', 'field_digits': True}"
                       groups="!D05_custom.group_sales_order_price_manager,!D05_custom.group_price_manager,!account.group_account_manager,!base.group_system"/>
                <field name="minimum_price" readonly="1" widget="monetary"
                       options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </field>
        </field>
    </record>
</odoo>
