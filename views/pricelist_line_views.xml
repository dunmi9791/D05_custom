<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_d05_pricelist_item_search" model="ir.ui.view">
        <field name="name">d05.product.pricelist.item.search</field>
        <field name="model">product.pricelist.item</field>
        <field name="arch" type="xml">
            <search string="Pricelist Lines">
                <field name="default_code" string="Internal Reference"
                       filter_domain="['|', '|', ('default_code', 'ilike', self), ('product_id.default_code', 'ilike', self), ('product_tmpl_id.default_code', 'ilike', self)]"/>
                <field name="product_tmpl_id" string="Product"/>
                <field name="product_id" string="Variant"/>
                <field name="pricelist_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="Active pricelists" name="active_pricelist"
                        domain="[('pricelist_id.active', '=', True)]"/>
                <filter string="Fixed price" name="filter_fixed"
                        domain="[('compute_price', '=', 'fixed')]"/>
                <filter string="Discount" name="filter_percentage"
                        domain="[('compute_price', '=', 'percentage')]"/>
                <filter string="Formula" name="filter_formula"
                        domain="[('compute_price', '=', 'formula')]"/>
                <group expand="0" string="Group By">
                    <filter string="Pricelist" name="groupby_pricelist" context="{'group_by': 'pricelist_id'}"/>
                    <filter string="Company" name="groupby_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_d05_pricelist_item_tree" model="ir.ui.view">
        <field name="name">d05.product.pricelist.item.tree</field>
        <field name="model">product.pricelist.item</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <tree string="Pricelist Lines" editable="bottom">
                <field name="default_code" readonly="1"/>
                <field name="product_tmpl_id" string="Product" options="{'no_create': True}"/>
                <field name="product_id" string="Variant" optional="hide"
                       groups="product.group_product_variant" options="{'no_create': True}"/>
                <field name="pricelist_id" options="{'no_create': True}"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="show"/>
                <field name="currency_id" optional="hide" readonly="1"/>
                <field name="compute_price"/>
                <field name="fixed_price" string="Fixed Price"/>
                <field name="percent_price" string="Discount %" optional="show"/>
                <field name="price_discount" string="Formula Discount %" optional="hide"/>
                <field name="price_surcharge" optional="hide"/>
                <field name="min_quantity" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="applied_on" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_pricelist_lines" model="ir.actions.act_window">
        <field name="name">Pricelist Lines</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_d05_pricelist_item_tree"/>
        <field name="search_view_id" ref="view_d05_pricelist_item_search"/>
        <field name="context">{'search_default_active_pricelist': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pricelist lines yet</p>
            <p>
                Search by product, internal reference, or pricelist, then edit the price in the list.
                A price cannot go below the product's minimum.
            </p>
        </field>
    </record>

    <record id="action_pricelist_lines_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_d05_pricelist_item_tree"/>
        <field name="act_window_id" ref="action_pricelist_lines"/>
    </record>

    <menuitem id="menu_pricelist_lines"
              name="Pricelist Lines"
              parent="sale.product_menu_catalog"
              action="action_pricelist_lines"
              sequence="25"/>

    <record id="product_pricelist_form_lines_button" model="ir.ui.view">
        <field name="name">product.pricelist.form.lines.button</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/widget[@name='web_ribbon']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_pricelist_lines" type="object"
                            class="oe_stat_button" icon="fa-list">
                        <field name="pricelist_line_count" widget="statinfo" string="Pricelist Lines"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
